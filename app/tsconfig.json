{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "lib": [
            "es2020"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "rootDir": "./"
    },
    "include": [
        "./services/**/*.ts",
        "./tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}