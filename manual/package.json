{
  "name": "finance-tracker-manual",
  "version": "1.0.0",
  "description": "Privacy-first offline finance tracking mobile app",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "demo": "cd demo && npm run web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e:ios": "detox test --configuration ios",
    "test:e2e:android": "detox test --configuration android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "build:ios": "react-native build-ios",
    "build:android": "react-native build-android",
    "clean": "react-native clean",
    "reset": "npx react-native clean && npm install && cd ios && pod install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.5",
    "@react-native-camera-roll/camera-roll": "^5.7.4",
    "@react-native-community/datetimepicker": "^7.6.2",
    "@react-native-picker/picker": "^2.4.10",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@reduxjs/toolkit": "^1.9.7",
    "babel-loader": "^10.0.0",
    "date-fns": "^2.30.0",
    "expo-camera": "^13.6.0",
    "expo-image-manipulator": "^11.5.0",
    "html-webpack-plugin": "^5.6.5",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.5.31",
    "react": "18.2.0",
    "react-hook-form": "^7.48.2",
    "react-native": "0.72.6",
    "react-native-biometrics": "^3.0.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-crypto-js": "^1.0.0",
    "react-native-document-picker": "^9.1.1",
    "react-native-elements": "^3.4.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-keychain": "^8.1.3",
    "react-native-pdf": "^6.7.3",
    "react-native-permissions": "^3.10.1",
    "react-native-reanimated": "^3.6.1",
    "react-native-safe-area-context": "^4.8.1",
    "react-native-screens": "^3.29.0",
    "react-native-share": "^9.4.1",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^13.14.0",
    "react-native-vector-icons": "^10.0.2",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "tesseract.js": "^4.1.4",
    "uuid": "^9.0.1",
    "victory-native": "^36.8.6",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "yup": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/runtime": "^7.23.6",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.12",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.2",
    "@tsconfig/react-native": "^3.0.2",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.45",
    "@types/react-native": "^0.72.7",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "babel-jest": "^29.7.0",
    "detox": "^20.15.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "resolutions": {
    "@types/react": "^18.2.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**/*",
      "!src/**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "detox": {
    "testRunner": "jest",
    "runnerConfig": "e2e/config.json",
    "configurations": {
      "ios": {
        "device": {
          "type": "ios.simulator",
          "device": "iPhone 14"
        },
        "app": {
          "type": "ios.app",
          "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/FinanceTrackerManual.app"
        }
      },
      "android": {
        "device": {
          "type": "android.emulator",
          "device": "Pixel_4_API_30"
        },
        "app": {
          "type": "android.apk",
          "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk"
        }
      }
    }
  }
}
